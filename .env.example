# Telegram
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_NAME=Anna
ADMIN_TELEGRAM_IDS=123456789,987654321

# Database (Railway supplies DATABASE_URL automatically)
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# LLM providers (at least one is required)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=minimax/minimax-m3
GEMINI_API_KEY=...
OPENAI_API_KEY=sk-...

# Image / video generation
# V3.19.5: Gemini/Veo is the primary video engine again (needs a clean ASCII
# GEMINI_API_KEY); Replicate is the first fallback.
REPLICATE_API_TOKEN=r8_...
FAL_KEY=...
IMAGE_API_KEY=...

# Photo idea engine (curated bank data/photo_ideas.json + LLM variations).
# PHOTO_IDEA_LLM_CHANCE = probability (0.0–1.0) that a fresh LLM variation is used.
PHOTO_IDEAS_ENABLED=true
PHOTO_IDEA_LLM_CHANCE=0.25

# Video "animate a photo" — sold for VIDEO_COST_STARS Stars (default 5).
# Backend is a free public Hugging Face Gradio space (1–3 min queue).
# Premium users get VIDEO_PREMIUM_FREE_DAILY free animations per day; extra same-day uses are paid.
HF_VIDEO_ENABLED=true
HF_VIDEO_SPACE=Wan-AI/Wan2.1
VIDEO_COST_STARS=5
VIDEO_PREMIUM_FREE_DAILY=1

# Voice
TTS_API_KEY=...
TTS_VOICE=nova

# Telegram Wallet Pay (crypto + card on-ramp)
WALLET_PAY_TOKEN=...
WALLET_PAY_WEBHOOK_URL=https://your-app.up.railway.app/walletpay/webhook
WALLET_PAY_TIMEOUT_SECONDS=30
STARS_TO_USD=0.02

# FreeKassa (card / SBP premium, v3.19.6). All three secrets are required,
# otherwise the card button and the webhook endpoints stay off.
# Use ASCII-only secret words (matching the merchant cabinet exactly).
FREEKASSA_MERCHANT_ID=75666
FREEKASSA_SECRET1=...
FREEKASSA_SECRET2=...
# V3.30.0: REST API key from the merchant cabinet (Settings -> API key).
# With it, orders go through https://api.fk.life/v1/orders/create and the
# returned `location` link is sent to the user; without it the legacy SCI
# form link is used.
FREEKASSA_API_KEY=...
# Optional override for the IP sent in orders/create (127.0.0.1 is rejected);
# by default the public egress IP is looked up automatically.
FREEKASSA_SERVER_IP=
FREEKASSA_PREMIUM_PRICE_RUB=299
# Public Railway domain of this service (Settings -> Networking).
PUBLIC_BASE_URL=https://your-app.up.railway.app

# Gamification & pricing
PREMIUM_MONTHLY_STARS=500
PREMIUM_MONTHLY_PHOTO_CREDITS=12
PHOTO_COST_STARS=25
FREE_MESSAGES_PER_DAY=80

# Misc
DEFAULT_TIMEZONE=UTC
PYTHONIOENCODING=utf-8

# Referral & first-start bonus (v3.16)
# Bonus credits granted once to brand-new users right after they accept 18+/terms.
FIRST_START_BONUS_CREDITS=2
# Optional short Premium trial handed to new users on first start. 0 = disabled.
FIRST_START_PREMIUM_TRIAL_DAYS=0
# Credits each side receives when a referral converts (both get this many photo credits).
REFERRAL_REFERRER_CREDITS=3
REFERRAL_INVITEE_CREDITS=3

# Video generation UX (v3.16)
# Status text shown to the user while an image-to-video job is running.
VIDEO_STATUS_TEXT=🎬 снимаю видео… это займёт 1–3 минуты. держись, если что-то пойдёт не так — Stars вернутся автоматически.
